#!/usr/bin/env bash
# Deterministically sample candidate files from a local/NAS tree into the
# gitignored corpus_local hierarchy.
set -u

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CORPUS_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
DEST_ROOT="${DEST_ROOT:-$CORPUS_DIR/corpus_local}"
INVENTORY_PATH="${INVENTORY_PATH:-}"

NAS_ROOT="${NAS_ROOT:-/Volumes/Fileserver}"
N="${N:-50}"
SEED="${SEED:-42}"
FORMAT_FILTER=""
DRY_RUN=0

usage() {
	cat <<EOF
Usage: tests/corpus/scripts/sample_local [options]

Options:
  --nas-root <path>  Root to sample from (default: /Volumes/Fileserver)
  --n <int>          Sample N files per format (default: 50)
  --seed <int>       Deterministic shuffle seed (default: 42)
  --format <name>    Restrict to one format bucket
  --dest-root <path>  Destination corpus_local root (default: tests/corpus/corpus_local)
  --inventory <path>  Reuse or create a private rg --files inventory
  --dry-run          Print the first few selected paths without copying
  -h, --help         Show this help
EOF
}

while [[ $# -gt 0 ]]; do
	case "$1" in
		--nas-root) shift; NAS_ROOT="$1" ;;
		--n) shift; N="$1" ;;
		--seed) shift; SEED="$1" ;;
		--format) shift; FORMAT_FILTER="$1" ;;
		--dest-root) shift; DEST_ROOT="$1" ;;
		--inventory) shift; INVENTORY_PATH="$1" ;;
		--dry-run) DRY_RUN=1 ;;
		-h|--help) usage; exit 0 ;;
		*) echo "unknown arg: $1" >&2; usage; exit 2 ;;
	esac
	shift
done

if [[ ! -d "$NAS_ROOT" ]]; then
	echo "FATAL: $NAS_ROOT not mounted" >&2
	exit 1
fi

if ! command -v rg >/dev/null 2>&1; then
	echo "FATAL: ripgrep (rg) not found in PATH" >&2
	exit 1
fi

formats=(
	"zip:zip"
	"docx:docx"
	"xlsx:xlsx"
	"pptx:pptx"
	"epub:epub"
	"jar:jar"
	"war:war"
	"ear:ear"
	"apk:apk"
	"ipa:ipa"
	"whl:whl"
	"xpi:xpi"
	"crx:crx"
	"vsix:vsix"
	"odt:odt"
	"ods:ods"
	"odp:odp"
	"cbz:cbz"
	"pdf:pdf"
	"png:png"
	"gzip:gz,tgz"
	"iwork:pages,numbers,key"
)

format_exts() {
	local wanted="$1"
	local spec format
	for spec in "${formats[@]}"; do
		format="${spec%%:*}"
		if [[ "$format" == "$wanted" ]]; then
			printf '%s\n' "${spec#*:}"
			return 0
		fi
	done
	return 1
}

build_rg_globs() {
	local exts_csv="$1"
	local globs_ref="$2"
	local ext
	IFS=',' read -r -a exts_raw <<< "$exts_csv"
	for ext in "${exts_raw[@]}"; do
		eval "$globs_ref+=(\"-g\" \"*.$ext\")"
	done
}

combined_exts() {
	local spec
	local all=""
	for spec in "${formats[@]}"; do
		if [[ -z "$all" ]]; then
			all="${spec#*:}"
		else
			all="$all,${spec#*:}"
		fi
	done
	printf '%s\n' "$all"
}

ensure_inventory_file() {
	local exts_csv="$1"
	local globs=()
	build_rg_globs "$exts_csv" globs

	if [[ -n "$INVENTORY_PATH" && -s "$INVENTORY_PATH" ]]; then
		printf '%s\n' "$INVENTORY_PATH"
		return 0
	fi

	local out_path="$INVENTORY_PATH"
	if [[ -z "$out_path" ]]; then
		out_path="$(mktemp "${TMPDIR:-/tmp}/dfp-file-inventory.XXXXXX")"
	fi

	if [[ -n "$INVENTORY_PATH" ]]; then
		mkdir -p "$(dirname "$INVENTORY_PATH")"
		local tmp_path="$INVENTORY_PATH.tmp.$$"
		rg --files --no-ignore --no-messages --hidden \
			"${globs[@]}" --glob '!._*' "$NAS_ROOT" > "$tmp_path" 2>/dev/null
		local rc=$?
		if [[ "$rc" -ne 0 ]]; then
			echo "FATAL: failed to build inventory at $INVENTORY_PATH" >&2
			exit "$rc"
		fi
		mv "$tmp_path" "$out_path"
		printf '%s\n' "$out_path"
		return 0
	fi

	rg --files --no-ignore --no-messages --hidden \
		"${globs[@]}" --glob '!._*' "$NAS_ROOT" > "$out_path" 2>/dev/null
	printf '%s\n' "$out_path"
}

filter_inventory_for_format() {
	local format="$1"
	local exts_csv
	exts_csv="$(format_exts "$format")" || return 1
	awk -v exts="$exts_csv" '
		BEGIN {
			n = split(exts, ext, ",")
			for (i = 1; i <= n; i++) wanted["." tolower(ext[i])] = 1
		}
		{
			path = tolower($0)
			for (suffix in wanted) {
				if (substr(path, length(path) - length(suffix) + 1) == suffix) {
					print $0
					next
				}
			}
		}
	'
}

sample_format() {
	local format="$1"
	local inventory_file="$2"
	local dest_dir="$DEST_ROOT/$format/wild"

	local existing=0
	if [[ -d "$dest_dir" ]]; then
		existing=$(find "$dest_dir" -type f 2>/dev/null | wc -l | awk '{print $1}')
	fi
	if [[ "$DRY_RUN" -eq 0 && "$existing" -ge "$N" ]]; then
		echo "$format: already has $existing files; skipping"
		return 0
	fi

	local candidates
	candidates=$(filter_inventory_for_format "$format" < "$inventory_file" \
		| awk -v seed="$SEED" 'BEGIN{srand(seed)} {print rand() "\t" $0}' \
		| sort -k1,1n \
		| cut -f2- \
		| head -n "$N")

	local count
	count=$(printf '%s\n' "$candidates" | grep -c . || true)
	if [[ "$count" -eq 0 ]]; then
		echo "$format: no candidates"
		return 0
	fi

	echo "$format: selected $count files"
	if [[ "$DRY_RUN" -eq 1 ]]; then
		printf '%s\n' "$candidates" | head -5 | sed 's/^/  /'
		return 0
	fi

	mkdir -p "$dest_dir"
	while IFS= read -r src; do
		[[ -n "$src" ]] || continue
		local base hash
		base="$(basename "$src")"
		hash="$(printf '%s' "$src" | shasum -a 256 | cut -c1-8)"
		cp -p "$src" "$dest_dir/${hash}_${base}" 2>/dev/null \
			|| echo "WARNING: failed to copy $src" >&2
	done <<< "$candidates"
}

inventory_exts="$(combined_exts)"
if [[ -n "$FORMAT_FILTER" ]]; then
	inventory_exts="$(format_exts "$FORMAT_FILTER")" || {
		echo "unknown format: $FORMAT_FILTER" >&2
		exit 2
	}
fi
INVENTORY_FILE="$(ensure_inventory_file "$inventory_exts")"

for spec in "${formats[@]}"; do
	format="${spec%%:*}"
	if [[ -n "$FORMAT_FILTER" && "$FORMAT_FILTER" != "$format" ]]; then
		continue
	fi
	sample_format "$format" "$INVENTORY_FILE"
done

echo "Local corpus root: $DEST_ROOT"
echo "NOTE: corpus_local is gitignored and may contain sensitive data."
